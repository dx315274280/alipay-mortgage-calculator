{
  "name": "mortgage-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "房贷与车贷计算器支付宝小程序",
  "scripts": {
    "postinstall": "node scripts/patch-taro-vite-runner.mjs",
    "build:alipay": "taro build --type alipay && node scripts/postbuild-alipay.mjs",
    "dev:alipay": "taro build --type alipay --watch",
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@tarojs/components": "4.2.0",
    "@tarojs/helper": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-alipay": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.26.3",
    "@tarojs/cli": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@types/react": "^18.3.12",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-preset-taro": "4.2.0",
    "postcss": "^8.4.49",
    "sass": "^1.81.0",
    "typescript": "^5.6.3",
    "vite": "^4.5.5"
  }
}
